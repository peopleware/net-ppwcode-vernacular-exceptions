<Project>
    <PropertyGroup>
        <!-- nuget package -->
        <IsPackable>true</IsPackable>

        <!-- Analyzer -->
        <CodeAnalysisRuleSet>..\Analyzer.ruleset</CodeAnalysisRuleSet>

        <!-- generate usings -->
        <ImplicitUsings>enable</ImplicitUsings>

        <!-- nullable reference types -->
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <!-- for stable package lock files across OSes -->
    <ItemGroup>
        <!-- none for now -->
    </ItemGroup>

    <!-- common dependencies included using GlobalPackageReference -->
</Project>
